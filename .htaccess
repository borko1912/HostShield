# HostShield dashboard: only index.php and assets/ are public.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

<FilesMatch "^(config\.php|install\.unlock)$|\.(md|json|jsonl|log|yml|yaml|sql|gz|zip|ini|lock|dist|xml)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|cron|waf|app|lang|tests|docs|vendor|\.git|\.github)(/|$) - [F,L]
</IfModule>
